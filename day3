-- 3. DISPLAY LAST_NAME, JOB_ID, EMPLOYEE_ID
-- EMPLOYEE_ID APPEARING FIRST

SELECT EMPLOYEE_ID, LAST_NAME, JOB_ID
FROM EMPLOYEE;


-- 4. DISPLAY ALL EMPLOYEES OF DEPARTMENT 60

SELECT *
FROM EMPLOYEE
WHERE DEPARTMENT_ID = 60;


-- 5. DISPLAY DETAILS OF EMPLOYEE WHOSE LAST_NAME IS KING

SELECT *
FROM EMPLOYEE
WHERE LAST_NAME = 'King';


-- 6. DISPLAY UNIQUE JOB_ID
-- ALIAS AS JOB_TITLE

SELECT DISTINCT JOB_ID AS JOB_TITLE
FROM EMPLOYEE;


-- 7. DISPLAY LAST_NAME, SALARY AND SALARY + 300
-- ALIAS AS "Increased Salary"

SELECT LAST_NAME,
       SALARY,
       SALARY + 300 AS "Increased Salary"
FROM EMPLOYEE;


-- 8. DISPLAY LAST_NAME, SALARY AND ANNUAL COMPENSATION
-- PLUS ONE-TIME BONUS OF RS 100

SELECT LAST_NAME,
       SALARY,
       (SALARY * 12) + 100 AS "Annual Compensation"
FROM EMPLOYEE;


-- 9. DISPLAY EMPLOYEES WHO GET COMMISSION

SELECT *
FROM EMPLOYEE
WHERE COMM_PCT IS NOT NULL;


-- 10. DISPLAY EMPLOYEES WHO DO NOT GET COMMISSION

SELECT *
FROM EMPLOYEE
WHERE COMM_PCT IS NULL;


-- 11. DISPLAY EMPLOYEE_ID, DEPARTMENT_ID AND SALARY
-- SALARY GREATER THAN 5000

SELECT EMPLOYEE_ID,
       DEPARTMENT_ID,
       SALARY
FROM EMPLOYEE
WHERE SALARY > 5000;


-- 12. DISPLAY LAST_NAME AND SALARY
-- SALARY BETWEEN 4000 AND 7000

SELECT LAST_NAME,
       SALARY
FROM EMPLOYEE
WHERE SALARY BETWEEN 4000 AND 7000;


-- 13. DISPLAY EMPLOYEES WHOSE SALARY IS
-- 6000 OR 6500 OR 7000

SELECT *
FROM EMPLOYEE
WHERE SALARY IN (6000, 6500, 7000);


-- 14. DISPLAY EMPLOYEES FROM DEPARTMENT
-- 10, 20, 30 OR 50

SELECT *
FROM EMPLOYEE
WHERE DEPARTMENT_ID IN (10, 20, 30, 50);


-- 15. DISPLAY EMPLOYEES WHOSE SALARY
-- IS NOT EQUAL TO 5000

SELECT *
FROM EMPLOYEE
WHERE SALARY <> 5000;


-- 16. DISPLAY ALL CLERKS

SELECT *
FROM EMPLOYEE
WHERE JOB_ID LIKE '%CLERK%';


-- 17. UPDATE JOB_ID OF EMPLOYEES
-- WHO EARN MORE THAN 5000 TO GRADE_A

UPDATE EMPLOYEE
SET JOB_ID = 'Grade_A'
WHERE SALARY > 5000;

COMMIT;

-- DISPLAY TABLE AFTER UPDATE
SELECT *
FROM EMPLOYEE;


-- 18. DISPLAY EMPLOYEES WHO ARE
-- CLERK, PROGRAMMER OR ASSISTANT

SELECT *
FROM EMPLOYEE
WHERE JOB_ID LIKE '%CLERK%'
   OR JOB_ID LIKE '%PROG%'
   OR JOB_ID LIKE '%ASST%';


-- 19. DISPLAY CLERKS WHOSE SALARY IS LESS THAN 3000

SELECT *
FROM EMPLOYEE
WHERE JOB_ID LIKE '%CLERK%'
  AND SALARY < 3000;


-- 20. DISPLAY LAST_NAME AND MGR_ID
-- SALARY ABOVE 3000 AND MANAGER 101

SELECT LAST_NAME,
       MGR_ID
FROM EMPLOYEE
WHERE SALARY > 3000
  AND MGR_ID = 101;
